# ───────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น deploy.env แล้วกรอกค่าจริงของเซิร์ฟเวอร์คุณ
# deploy.env ถูก gitignore ไว้แล้ว (ตรงกับ pattern .env* ) จะไม่ถูก commit
#   cp deploy.env.example deploy.env
# ───────────────────────────────────────────────────────────────

# --- ข้อมูลเชื่อมต่อ SSH ไปยังเซิร์ฟเวอร์ปลายทาง ---
DEPLOY_SSH_USER=youruser
DEPLOY_SSH_HOST=your.server.ip.or.hostname
DEPLOY_SSH_PORT=22
# โฟลเดอร์บนเซิร์ฟเวอร์ที่จะ rsync โค้ดไปเก็บแล้ว build ที่นั่น
DEPLOY_REMOTE_DIR=~/apps/alam
# พอร์ตบนเซิร์ฟเวอร์ที่จะ map เข้า container (ตามที่ขอ = 4007)
DEPLOY_APP_PORT=4007
DEPLOY_CONTAINER_NAME=alam-app
DEPLOY_IMAGE_NAME=alam-app

# ───────────────────────────────────────────────────────────────
# ค่าด้านล่างนี้ (ที่ไม่ขึ้นต้นด้วย DEPLOY_) จะถูกส่งเข้า container
# เป็น environment variables ของแอปจริง (ผ่าน docker run --env-file)
# ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ต้องชี้ไปที่ PostgreSQL ที่เซิร์ฟเวอร์ปลายทางเข้าถึงได้จริง
# (ถ้ายังไม่มี Postgres บนเซิร์ฟเวอร์ ให้ตั้งค่าฐานข้อมูลไว้ก่อน เช่นรัน
#  docker-compose.yml ที่มีในโปรเจกต์นี้บนเซิร์ฟเวอร์ แล้วชี้มาที่ container นั้น)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ใช้โดย src/services/nas — ดู .env.example ประกอบ
NAS_BASE_URL=https://nas.csmju.com
NAS_USERNAME=studio
NAS_PASSWORD=changeme
