# ───────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env.production แล้วกรอกค่าจริงของเซิร์ฟเวอร์
#   cp .env.production.example .env.production
# deploy/02-deploy.sh จะคัดลอก .env.production -> .env ให้อัตโนมัติ
# ในการรันครั้งแรก (ทั้งคู่ถูก gitignore ไว้แล้ว ตรงกับ pattern .env*)
# ───────────────────────────────────────────────────────────────

NODE_ENV=production

# พอร์ตบนเซิร์ฟเวอร์ที่จะเปิดให้เข้าเว็บ (ตามที่ขอ = 4007)
APP_PORT=4007

# --- PostgreSQL (รันเป็น container ของตัวเองผ่าน docker-compose.prod.yml) ---
# แก้รหัสผ่านให้เป็นค่าจริงที่ปลอดภัยก่อน deploy จริง
POSTGRES_USER=alumni
POSTGRES_PASSWORD=changeme_ก่อน_deploy_จริง
POSTGRES_DB=alam_db
# DATABASE_URL ต้องตรงกับ 3 ค่าด้านบน — host เป็นชื่อ service "db" ใน docker-compose (ไม่ใช่ localhost)
DATABASE_URL=postgresql://alumni:changeme_ก่อน_deploy_จริง@db:5432/alam_db

# ใช้โดย src/services/nas — ดู .env.example ประกอบ
NAS_BASE_URL=https://nas.csmju.com
NAS_USERNAME=studio
NAS_PASSWORD=changeme
