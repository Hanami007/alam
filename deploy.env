# ───────────────────────────────────────────────────────────────
# ไฟล์นี้ gitignore ไว้แล้ว (ตรงกับ pattern .env* ) จะไม่ถูก commit
# ───────────────────────────────────────────────────────────────

# --- ข้อมูลเชื่อมต่อ SSH ไปยังเซิร์ฟเวอร์ปลายทาง ---
DEPLOY_SSH_USER=alumni
DEPLOY_SSH_HOST=alumni.csmju.com
DEPLOY_SSH_PORT=22
# โฟลเดอร์บนเซิร์ฟเวอร์ที่จะเก็บโค้ดแล้ว build ที่นั่น
DEPLOY_REMOTE_DIR=~/apps/alam
# พอร์ตบนเซิร์ฟเวอร์ที่จะ map เข้า container (ตามที่ขอ = 4007)
DEPLOY_APP_PORT=4007
DEPLOY_CONTAINER_NAME=alam-app
DEPLOY_IMAGE_NAME=alam-app

# ───────────────────────────────────────────────────────────────
# ค่าด้านล่างนี้ (ที่ไม่ขึ้นต้นด้วย DEPLOY_) จะถูกส่งเข้า container
# เป็น environment variables ของแอปจริง (ผ่าน docker run --env-file)
# ───────────────────────────────────────────────────────────────
NODE_ENV=production

# TODO: ยังไม่ได้รับค่านี้ — ต้องกรอกก่อน deploy จริง (Postgres ที่เซิร์ฟเวอร์
# alumni.csmju.com เข้าถึงได้จริง)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ใช้โดย src/services/nas — ดู .env.example ประกอบ
NAS_BASE_URL=https://nas.csmju.com
NAS_USERNAME=studio
NAS_PASSWORD=changeme
